# Django
DJANGO_SECRET_KEY=replace-with-strong-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-web-app-name.azurewebsites.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-web-app-name.azurewebsites.net

# CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://your-frontend-host

# Shared cloud database (recommended: Azure Database for PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL_REQUIRE=True

# Shared cloud broker (recommended: Azure Cache for Redis)
CELERY_BROKER_URL=redis://:password@host:6379/0
